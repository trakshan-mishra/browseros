        properties: {
          path: { type: 'string', description: 'Path to write the file to, e.g., ~/Documents/pancake_ingredients.txt' },
          content: { type: 'string', description: 'The text content to write into the file' }
        },
        required: ['path', 'content']
      }
    }
  },
  {
    type: 'function',
    function: {
