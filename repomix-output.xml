}

.cd-list-item {
  display: grid;
  grid-template-columns: 1fr 90px 140px;
  padding: 6px 16px;
  font-size: 12.5px;
  cursor: pointer;
  transition: all 0.12s;
  border-bottom: 1px solid rgba(255,255,255,0.02);
}

.cd-list-item:hover {
  background: rgba(255,255,255,0.03);
}

.cd-item-selected {
  background: rgba(100, 130, 255, 0.1) !important;
  border-color: rgba(100, 130, 255, 0.15) !important;
}

.cd-col-name {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.cd-file-icon { font-size: 16px; flex-shrink: 0; }

.cd-file-name {
  overflow: hidden;
