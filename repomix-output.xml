}

.cd-search svg { color: #555; flex-shrink: 0; }

.cd-search input {
  background: none;
  border: none;
  color: #e0e0f0;
  font-size: 12px;
  padding: 5px 0;
  width: 120px;
  outline: none;
}

.cd-search input::placeholder { color: #555; }

.cd-view-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border: none;
  background: rgba(255,255,255,0.03);
  color: #666;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.15s;
}

.cd-view-btn:hover { background: rgba(255,255,255,0.06); color: #aaa; }
.cd-view-active { background: rgba(100,130,255,0.15) !important; color: #8ab4ff !important; }

/* ─── File List ───────────────────────────────── */
.cd-content {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 2px 0;
}

.cd-content::-webkit-scrollbar { width: 5px; }
.cd-content::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 3px; }

.cd-content.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
  gap: 4px;
  padding: 12px;
  align-content: start;
}

.cd-list-header {
  display: grid;
  grid-template-columns: 1fr 90px 140px;
  padding: 6px 16px;
  font-size: 10.5px;
  text-transform: uppercase;
