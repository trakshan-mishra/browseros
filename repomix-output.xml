<file path="src/apps/AIAssistant.css">
.ai-assistant {
  height: 100%; display: flex; flex-direction: column;
  background: linear-gradient(180deg, rgba(20,15,35,0.95), rgba(15,12,28,0.98));
}
.ai-header {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 18px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  background: rgba(255,255,255,0.03);
}
.ai-avatar {
  width: 40px; height: 40px; border-radius: 12px;
  background: linear-gradient(135deg, #BF5AF2, #7B2FBE);
  display: flex; align-items: center; justify-content: center;
  font-size: 22px;
  box-shadow: 0 4px 12px rgba(191,90,242,0.3);
}
.ai-name { font-size: 15px; font-weight: 700; }
.ai-status { font-size: 11px; color: var(--text-muted); }
.ai-messages {
  flex: 1; overflow-y: auto; padding: 16px;
  display: flex; flex-direction: column; gap: 12px;
}
.ai-actions {
  display: flex; gap: 8px; padding: 10px 14px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  overflow-x: auto;
}
.ai-actions button {
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.07);
  color: var(--text-primary);
  border-radius: 10px;
  padding: 7px 10px;
  white-space: nowrap;
  cursor: pointer;
}
.ai-msg {
  max-width: 85%; animation: slideUp 0.25s ease;
}
.ai-msg-user {
  align-self: flex-end;
}
.ai-msg-assistant {
  align-self: flex-start;
}
.ai-msg-content {
  padding: 10px 14px; border-radius: 16px;
  font-size: 13.5px; line-height: 1.6;
  white-space: pre-wrap; word-break: break-word;
}
.ai-msg-user .ai-msg-content {
  background: linear-gradient(135deg, var(--accent), #0A84FF);
  color: white; border-bottom-right-radius: 4px;
}
.ai-msg-assistant .ai-msg-content {
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.06);
  border-bottom-left-radius: 4px;
}
.ai-typing {
  display: flex; gap: 5px; padding: 14px 18px;
}
.ai-typing span {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--purple);
  animation: typingDots 1.4s infinite ease-in-out;
}
.ai-typing span:nth-child(2) { animation-delay: 0.2s; }
.ai-typing span:nth-child(3) { animation-delay: 0.4s; }
.ai-input-row {
  display: flex; gap: 8px; padding: 12px 14px;
  border-top: 1px solid rgba(255,255,255,0.06);
  background: rgba(255,255,255,0.02);
}
.ai-input {
  flex: 1; background: var(--input-bg);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 12px; padding: 10px 14px;
  color: var(--text-primary); font-size: 13.5px;
}
.ai-input:focus { border-color: rgba(191,90,242,0.4); }
.ai-input::placeholder { color: var(--text-muted); }
.ai-send {
  width: 40px; height: 40px; border-radius: 12px;
  background: linear-gradient(135deg, #BF5AF2, #7B2FBE);
  border: none; color: white; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: var(--transition);
}
.ai-send:hover { transform: scale(1.05); box-shadow: 0 4px 16px rgba(191,90,242,0.4); }
.ai-send:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

.ai-extra-btn {
  width: 40px; height: 40px; border-radius: 12px;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.08);
  color: var(--text-primary); cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: var(--transition);
}
.ai-extra-btn:hover { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.2); }
.ai-extra-btn.recording {
  background: rgba(255, 69, 58, 0.2);
  border-color: rgba(255, 69, 58, 0.4);
  color: #FF453A;
  animation: pulseRed 1.5s infinite;
}

@keyframes pulseRed {
  0% { box-shadow: 0 0 0 0 rgba(255, 69, 58, 0.4); }
  70% { box-shadow: 0 0 0 10px rgba(255, 69, 58, 0); }
  100% { box-shadow: 0 0 0 0 rgba(255, 69, 58, 0); }
}

.ai-mic-btn {
  background: rgba(255, 255, 255, 0.05);
  border: none;
  border-radius: 8px;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
