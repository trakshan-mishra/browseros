/* ═══════════════════════════════════════════════
   Cloud Drive — Premium File Sync App
   ═══════════════════════════════════════════════ */

.cloud-drive {
  display: flex;
  height: 100%;
  background: #0d0d14;
  color: #e8e8f0;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  overflow: hidden;
  border-radius: 0 0 10px 10px;
}

/* ─── Sidebar ─────────────────────────────────── */
.cd-sidebar {
  width: 220px;
  min-width: 220px;
  background: linear-gradient(180deg, #12121c 0%, #0a0a12 100%);
  border-right: 1px solid rgba(255,255,255,0.06);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.cd-sidebar::-webkit-scrollbar { width: 4px; }
.cd-sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px; }

.cd-sidebar-header {
  padding: 16px 14px 12px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.cd-logo {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cd-logo-icon {
  font-size: 22px;
  filter: drop-shadow(0 0 8px rgba(100, 150, 255, 0.5));
}

.cd-logo-text {
  font-size: 15px;
  font-weight: 700;
  background: linear-gradient(135deg, #7eb4ff, #b388ff);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: -0.3px;
}

.cd-sidebar-nav {
  padding: 8px 8px 4px;
}

.cd-nav-item, .cd-quick-item, .cd-device-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 7px 10px;
  border: none;
  background: transparent;
  color: #a0a0b8;
  font-size: 12.5px;
  border-radius: 7px;
  cursor: pointer;
  transition: all 0.15s;
  text-align: left;
}

.cd-nav-item:hover, .cd-quick-item:hover, .cd-device-item:hover {
  background: rgba(255,255,255,0.05);
  color: #e0e0f0;
}

.cd-nav-active {
  background: rgba(100, 130, 255, 0.12) !important;
  color: #8ab4ff !important;
}

.cd-nav-icon { font-size: 14px; }

.cd-badge {
  margin-left: auto;
  background: rgba(100, 130, 255, 0.25);
  color: #8ab4ff;
  font-size: 10px;
  padding: 1px 6px;
  border-radius: 8px;
  font-weight: 600;
}

.cd-badge-dot {
  margin-left: auto;
  width: 6px;
  height: 6px;
  background: #4ade80;
  border-radius: 50%;
  animation: cd-pulse 2s infinite;
}

@keyframes cd-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}

.cd-sidebar-section {
  padding: 8px;
  border-top: 1px solid rgba(255,255,255,0.04);
}

.cd-section-title {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #555570;
  padding: 6px 10px 4px;
  font-weight: 600;
}

.cd-device-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}

.cd-dot-online { background: #4ade80; box-shadow: 0 0 6px rgba(74,222,128,0.5); }
.cd-dot-offline { background: #666; }

.cd-device-active {
  background: rgba(74, 222, 128, 0.08) !important;
  color: #4ade80 !important;
}

/* ─── Main Content ────────────────────────────── */
.cd-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-width: 0;
}

/* ─── Toolbar ─────────────────────────────────── */
.cd-toolbar {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  gap: 8px;
  background: rgba(18, 18, 28, 0.8);
  border-bottom: 1px solid rgba(255,255,255,0.05);
  backdrop-filter: blur(10px);
  flex-shrink: 0;
}

.cd-toolbar-left {
  display: flex;
  gap: 2px;
}

.cd-tool-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border: none;
  background: rgba(255,255,255,0.04);
  color: #888;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.15s;
}

.cd-tool-btn:hover:not(:disabled) {
  background: rgba(255,255,255,0.08);
  color: #ccc;
}

.cd-tool-btn:disabled { opacity: 0.3; cursor: default; }

.cd-breadcrumb {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 2px;
  overflow-x: auto;
  padding: 0 4px;
}

.cd-breadcrumb::-webkit-scrollbar { display: none; }

.cd-device-tag {
  font-size: 10.5px;
  padding: 2px 7px;
  background: linear-gradient(135deg, rgba(100,130,255,0.15), rgba(160,100,255,0.15));
  border: 1px solid rgba(100,130,255,0.2);
  border-radius: 5px;
  color: #8ab4ff;
  font-weight: 500;
  white-space: nowrap;
}

.cd-breadcrumb-sep {
  color: #444;
  font-size: 12px;
  margin: 0 1px;
}

.cd-crumb-btn {
  border: none;
  background: none;
  color: #888;
  font-size: 12px;
  padding: 2px 4px;
  border-radius: 4px;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.15s;
}

.cd-crumb-btn:hover { background: rgba(255,255,255,0.06); color: #ccc; }
.cd-crumb-btn:last-child { color: #e0e0f0; font-weight: 500; }

.cd-toolbar-right {
  display: flex;
  gap: 4px;
  align-items: center;
}

.cd-search {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.06);
